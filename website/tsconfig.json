{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["./**/*.mts", "./**/*.cts", "../scripts/istanbul-instrument.d.mts"],
  "exclude": ["node_modules", "test-results", ".admin-dist", ".business-dist", ".safety-preview"]
}
