{
  "name": "doit",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "eas-build-pre-install": "node scripts/verify-build-env.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit && npm run typecheck:fixtures",
    "typecheck:fixtures": "tsc --project scripts/fixtures/tsconfig.json --noEmit && node scripts/test-fixture-typecheck.cjs",
    "check:size": "node scripts/check-source-size.mjs",
    "format": "prettier --write .",
    "test": "jest",
    "test:database:prepare": "node scripts/database/prepare-images.mjs",
    "test:database:guards": "node scripts/database/guards.test.mjs",
    "test:database": "npm run test:database:guards && node scripts/database/clean-room.mjs",
    "test:database:repro": "node scripts/database/reproducibility.mjs",
    "test:coverage": "node scripts/run-coverage.cjs",
    "test:coverage:report": "node scripts/check-coverage.cjs",
    "test:admin-auth": "node website/admin-portal/live-client.test.mjs",
    "test:admin-e2e": "node website/build-admin.mjs && playwright test --config=website/admin-portal/playwright.config.mjs",
    "test:admin-health": "node website/admin-portal/health-model.test.cjs",
    "test:admin-portal": "npm run test:admin-auth && npm run test:admin-health && npm run test:admin-e2e",
    "test:fanout-model": "node scripts/load/fanout-model.mjs",
    "test:social-fanout-model": "node scripts/load/social-fanout-model.mjs",
    "test:scale-bursts": "node scripts/load/social-fanout-model.mjs --burst-seconds=30 && node scripts/load/social-fanout-model.mjs --burst-seconds=60 && node scripts/load/social-fanout-model.mjs --burst-seconds=120"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo-google-fonts/sora": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.105.3",
    "@tanstack/react-query": "^5.100.9",
    "ably": "^2.26.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "expo": "~57.0.26",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.75.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "tus-js-client": "^4.3.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.55.0",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/pg": "8.23.1",
    "@types/react": "~19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "babel-plugin-dynamic-import-node": "2.3.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "5.2.1",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "minimatch": "10.2.6",
    "prettier": "^3.8.3",
    "supabase": "^2.113.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "uuid": "^11.1.1"
  },
  "jest": {
    "preset": "jest-expo",
    "transform": {
      "\\.[jt]sx?$": "<rootDir>/jest.transform.cjs"
    },
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@react-native-async-storage/async-storage$": "@react-native-async-storage/async-storage/jest/async-storage-mock",
      "^react-native-keyboard-controller$": "<rootDir>/__mocks__/react-native-keyboard-controller.js"
    },
    "testPathIgnorePatterns": [
      "<rootDir>/.claude/",
      "<rootDir>/test-results/",
      "<rootDir>/website/test-results/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/",
      "<rootDir>/test-results/",
      "<rootDir>/website/test-results/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|standard-navigation|@react-navigation/.*|@supabase/.*|zustand)"
    ]
  },
  "private": true,
  "allowScripts": {
    "@sentry/cli@2.58.4": true
  }
}
