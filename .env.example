# Public client configuration only. Never put service-role or vendor API secrets here.
# This example requires an approved local Supabase stack; it does not provision one.
# Copy to .env.local only if that file does not already exist.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_LOCAL_PUBLIC_ANON_KEY
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_COMMAND_GATEWAY_URL=
EXPO_PUBLIC_SCALE_READ_URL=
EXPO_PUBLIC_MEDIA_TRANSFORMS_ENABLED=false
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_RELEASE_CHANNEL=development
