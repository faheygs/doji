{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doji-orchestrator-staging",
  "main": "src/staging.ts",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "DOJI_ENVIRONMENT": "staging",
    "STAGING_BACKEND_ENABLED": "true",
    "SUPABASE_URL": "https://ohrcupagdoilkwhecict.supabase.co",
    "ADMIN_PORTAL_EMPLOYEE_ACCOUNTS": "true",
    "ADMIN_PORTAL_ORIGINS": "https://admin-staging.dojipro.com",
    "SCALE_CACHE_VERSION": "staging-v1"
  },
  "durable_objects": {
    "bindings": [
      { "name": "DOJI_EVENT_ALARM", "class_name": "DojiEventAlarm" },
      { "name": "OUTBOX_RELAY_ALARM", "class_name": "OutboxRelayAlarm" },
      { "name": "PUSH_FANOUT_ALARM", "class_name": "PushFanoutAlarm" },
      { "name": "DATA_MAINTENANCE_ALARM", "class_name": "DataMaintenanceAlarm" },
      { "name": "HEALTH_MONITOR", "class_name": "HealthMonitor" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DojiEventAlarm"] },
    { "tag": "v2", "new_sqlite_classes": ["OutboxRelayAlarm"] },
    { "tag": "v3", "new_sqlite_classes": ["DataMaintenanceAlarm"] },
    { "tag": "v4", "new_sqlite_classes": ["PushFanoutAlarm"] },
    { "tag": "v5", "new_sqlite_classes": ["HealthMonitor"] }
  ],
  "observability": { "enabled": true },
  "triggers": { "crons": [] }
}
