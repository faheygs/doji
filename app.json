{
  "expo": {
    "name": "Doji",
    "slug": "doit-challenge-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "doit",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.doit.challengeapp",
      "infoPlist": {
        "NSCameraUsageDescription": "Doji needs camera access to capture your challenge proof.",
        "NSMicrophoneUsageDescription": "Doji needs microphone access for video challenges.",
        "NSPhotoLibraryUsageDescription": "Doji uses your photo library for challenge proof and your profile picture.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "19"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.doit.challengeapp",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#0A0A0A",
      "iosDisplayInForeground": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Doji needs camera access to capture your challenge proof.",
          "microphonePermission": "Doji needs microphone access for video challenges."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Doji needs photo library access to save your challenge posts.",
          "savePhotosPermission": "Doji needs permission to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Doji uses your photos and videos when you attach challenge proof or a profile picture.",
          "cameraPermission": "Doji needs camera access to capture your challenge proof or profile photo."
        }
      ],
      "expo-notifications",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "064b68b6-f138-4962-8aeb-f00970ba39c8"
      }
    },
    "owner": "faheybaby"
  }
}
