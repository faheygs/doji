# Mobile-only upload boundary. This replaces .gitignore for EAS archives.
# Root allowlist intentionally excludes portal/backend/deployment/test snapshots.
/*
!/app
!/assets
!/components
!/constants
!/contexts
!/contracts
!/hooks
!/lib
!/stores
!/types
!/utils
!/modules
/modules/*
!/modules/doji-test-environment
/modules/doji-test-environment/android/build/
/modules/doji-test-environment/android/.gradle/
!/vendor
/vendor/*
!/vendor/decode-uri-component-compat
!/scripts
/scripts/*
!/scripts/verify-build-env.mjs
!/plugins
/plugins/*
!/plugins/withAndroidReadDiagnostics.cts
!/plugins/android-read-diagnostics
/plugins/android-read-diagnostics/*
!/plugins/android-read-diagnostics/DojiReadResponseHints.java
!/plugins/android-read-diagnostics/expoClientPatch.cts
!/app.json
!/babel.config.cts
!/eas.json
!/google-services.json
!/index.ts
!/package.json
!/package-lock.json
!/tsconfig.json
!/.easignore

# Retain secret/generated exclusions even inside allowed source directories.
node_modules/
.expo/
dist/
coverage/
.env*
*.tsbuildinfo
*.orig.*
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision
.DS_Store
npm-debug.*
yarn-debug.*
yarn-error.*
